---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import { imgAttrs } from '../utils/images';

const siteUrl = (Astro.site || Astro.url.origin).toString();
const pageUrl = new URL('/photographe-mariage-vienne/', siteUrl).toString();

const title = "Photographe mariage Vienne (38) : reportage de votre journée";
const description = "Hedi, photographe de mariage à Vienne (Isère) : depuis 2020, une dizaine de mariages par an, des préparatifs à la soirée. Formule unique à 1 600 €, séance engagement offerte.";

const hero = projects.find(p => p.slug === 'morgane-franck')!;
const strip = ['fanny-ben', 'assia-jeremy', 'lucy-romain'].map(slug => projects.find(p => p.slug === slug)!);

const faqItems = [
  { q: "Combien de mariages photographiez-vous par an ?", a: "Une dizaine. Je photographie des mariages depuis 2020 et je garde volontairement un nombre limité de dates, pour être pleinement disponible pour chaque couple, avant comme après le jour J." },
  { q: "Vous déplacez-vous autour de Vienne ?", a: "Oui. Depuis Vienne, j'interviens dans tout le Pays viennois, en Isère, dans la région lyonnaise et plus largement en Auvergne-Rhône-Alpes. Les frais de déplacement sont inclus dans la formule." },
  { q: "Peut-on se rencontrer avant de réserver ?", a: "Bien sûr. Après un premier échange par mail ou par téléphone, je vous propose de nous rencontrer pour parler de vos envies et du déroulé de votre journée. La date est réservée à la signature du contrat, avec un acompte de 30 %." },
  { q: "Combien de temps à l'avance faut-il réserver ?", a: "Pour la haute saison, je vous conseille de réserver environ 12 mois à l'avance. Le plus simple est de me demander si votre date est encore libre." },
  { q: "Où faire la séance engagement ?", a: "Où vous le souhaitez. À Vienne, les vestiges romains, la vieille ville et les quais du Rhône s'y prêtent très bien, mais un lieu qui compte pour vous deux est souvent le meilleur choix." },
  { q: "Que contient la formule à 1 600 € ?", a: "Le reportage de toute la journée, des préparatifs à la soirée, la galerie en ligne des photos retouchées, une clé USB, 50 tirages dans un coffret, les frais de déplacement et une séance engagement offerte avant le mariage." }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": title,
      "description": description,
      "inLanguage": "fr-FR",
      "about": { "@id": `${siteUrl}#business` }
    },
    {
      "@type": "Service",
      "serviceType": "Photographe de mariage",
      "name": "Reportage photo de mariage à Vienne",
      "provider": { "@id": `${siteUrl}#business` },
      "areaServed": [
        { "@type": "City", "name": "Vienne" },
        { "@type": "AdministrativeArea", "name": "Isère" },
        { "@type": "City", "name": "Lyon" }
      ],
      "offers": { "@type": "Offer", "price": "1500", "priceCurrency": "EUR" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Photographe de mariage à Vienne", "item": pageUrl }
      ]
    }
  ]
};
---

<Layout title={title} description={description} image={hero.heroImage} hideLoadingOverlay={true}>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="w-full bg-surface text-accent">

    {/* Intro */}
    <header class="px-6 md:px-12 pt-32 md:pt-44 max-w-7xl mx-auto grid md:grid-cols-2 gap-10 md:gap-16 items-end">
      <div>
        <p class="font-sans text-[10px] md:text-xs uppercase tracking-[0.2em] opacity-80 mb-6">Vienne (38200), Isère</p>
        <h1 class="font-serif font-light text-[12vw] md:text-[5.2vw] leading-[1.02] tracking-[-0.02em] text-balance">
          Photographe de mariage à Vienne
        </h1>
        <p class="font-serif font-light text-xl md:text-2xl leading-snug text-balance mt-8 opacity-90">
          Je m'appelle Hedi. Depuis 2020, je photographie une dizaine de mariages par an, depuis Vienne, où je suis installé.
          Des préparatifs à la soirée, je raconte votre journée avec sincérité et élégance.
        </p>
        <a href="/contact/" class="inline-block mt-10 font-sans text-xs uppercase tracking-[0.2em] border-b border-accent/60 pb-1 hover:opacity-70 transition-opacity">Vérifier ma date</a>
      </div>
      <figure class="m-0">
        <img
          {/* Landscape photo cropped to 4:5, so it renders ~1.9× wider than its box */}
          {...imgAttrs(hero.heroImage!, "(min-width: 768px) 85vw, 190vw")}
          alt={hero.heroAlt}
          class="w-full aspect-[4/5] object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="font-sans text-[10px] uppercase tracking-widest opacity-60 mt-3">
          {hero.couple}, mariage {hero.venue.inName} ({hero.venue.department})
        </figcaption>
      </figure>
    </header>

    <div class="px-6 md:px-12 max-w-3xl mx-auto mt-24 md:mt-36 font-serif font-light text-lg md:text-xl leading-relaxed space-y-20 md:space-y-28">

      <section>
        <h2 class="font-sans text-[10px] md:text-xs font-semibold uppercase tracking-widest opacity-80 mb-6">Un photographe installé à Vienne</h2>
        <p class="mb-5">
          Vienne est à une trentaine de kilomètres au sud de Lyon, entre l'Isère, le Rhône et la Loire. C'est d'ici que je pars pour chaque mariage :
          les domaines du Pays viennois, les châteaux du Nord-Isère et les salles de la région lyonnaise sont à portée de route, sans frais de déplacement en plus.
        </p>
        <p class="mb-5">
          Je travaille seul. Le photographe que vous rencontrez avant le mariage est celui qui sera à vos côtés le jour J :
          je photographie personnellement chaque mariage que je réserve.
        </p>
        <p>
          Mon approche tient en peu de mots : rester discret pendant les moments qui comptent, et vous guider avec bienveillance
          le temps des portraits, pour que l'expérience face à l'objectif reste naturelle.
        </p>
      </section>

      <section>
        <h2 class="font-sans text-[10px] md:text-xs font-semibold uppercase tracking-widest opacity-80 mb-6">Votre journée, des préparatifs à la soirée</h2>
        <p class="mb-5">
          <strong class="font-normal">Les préparatifs.</strong> J'arrive le matin, pendant que vous vous préparez : les tenues, les détails, les proches qui s'affairent,
          l'émotion qui monte.
        </p>
        <p class="mb-5">
          <strong class="font-normal">La cérémonie.</strong> Mairie, église ou cérémonie laïque, je me fais oublier pour saisir les regards,
          les mains qui tremblent et les sourires de vos invités.
        </p>
        <p class="mb-5">
          <strong class="font-normal">Le cocktail et les portraits.</strong> Je photographie la fête sur le vif, puis nous nous éclipsons
          un moment à deux pour vos portraits de couple, de préférence quand la lumière s'adoucit.
        </p>
        <p>
          <strong class="font-normal">La soirée.</strong> Les discours, l'entrée des mariés, la découpe du gâteau et la piste de danse :
          je reste jusqu'aux heures avancées de la soirée.
        </p>
      </section>

    </div>

    {/* Photo strip from real reportages */}
    <div class="px-6 md:px-12 max-w-7xl mx-auto mt-24 md:mt-36 grid grid-cols-1 md:grid-cols-3 gap-6">
      {strip.map((project) => (
        <a href={`/projets/${project.slug}/`} class="block group">
          <img
            {...imgAttrs(project.heroImage!, "(min-width: 768px) 30vw, 100vw")}
            alt={project.heroAlt}
            class="w-full aspect-[4/5] object-cover group-hover:opacity-90 transition-opacity"
            loading="lazy"
            decoding="async"
          />
          <span class="block font-sans text-[10px] uppercase tracking-widest opacity-70 mt-3">
            {project.couple} · {project.venue.name}, {project.venue.city}
          </span>
        </a>
      ))}
    </div>

    <div class="px-6 md:px-12 max-w-3xl mx-auto mt-24 md:mt-36 font-serif font-light text-lg md:text-xl leading-relaxed space-y-20 md:space-y-28">

      <section>
        <h2 class="font-sans text-[10px] md:text-xs font-semibold uppercase tracking-widest opacity-80 mb-6">Les lieux où j'ai photographié des mariages</h2>
        <p class="mb-8">
          Chaque reportage raconte une journée entière dans un lieu différent, avec quelques conseils pour les couples qui s'y marient à leur tour.
        </p>
        <ul class="list-none p-0 m-0 border-t border-accent/20">
          {projects.map((project) => (
            <li class="border-b border-accent/20">
              <a href={`/projets/${project.slug}/`} class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 hover:opacity-70 transition-opacity">
                <span>{project.venue.name}</span>
                <span class="font-sans text-[10px] md:text-xs uppercase tracking-widest opacity-70">{project.venue.city} ({project.venue.department})</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8">
          J'ai aussi photographié des mariages au Domaine de Grand Maison. Si votre lieu n'apparaît pas ici, ce n'est pas un problème :
          je prends le temps de le découvrir avec vous avant le jour J.
        </p>
      </section>

      <section>
        <h2 class="font-sans text-[10px] md:text-xs font-semibold uppercase tracking-widest opacity-80 mb-6">Vienne, un décor pour votre séance engagement</h2>
        <p class="mb-5">
          Une séance photo à deux est offerte avant chaque mariage. Elle sert surtout à faire connaissance, pour que vous soyez à l'aise le jour J.
        </p>
        <p>
          Si vous la faites à Vienne, la ville ne manque pas de décors : le temple d'Auguste et de Livie et les ruelles de la vieille ville,
          le jardin de Cybèle, les gradins du théâtre antique, la vue depuis le mont Pipet ou les quais du Rhône en fin de journée.
          Nous choisissons ensemble le lieu et l'heure qui vous ressemblent.
        </p>
      </section>

      <section>
        <h2 class="font-sans text-[10px] md:text-xs font-semibold uppercase tracking-widest opacity-80 mb-6">Une formule unique</h2>
        <p class="font-serif text-[12vw] md:text-6xl font-light leading-none tracking-widest my-6">1 600 €</p>
        <p class="mb-5">Pour la journée complète, sans option à ajouter :</p>
        <ul class="list-none p-0 m-0 space-y-2">
          <li>— le reportage, des préparatifs à la soirée ;</li>
          <li>— la galerie en ligne de vos photos retouchées ;</li>
          <li>— une clé USB et 50 tirages dans un coffret ;</li>
          <li>— les frais de déplacement ;</li>
          <li>— une séance engagement offerte avant le mariage.</li>
        </ul>
      </section>

      <section id="questions">
        <h2 class="font-sans text-[10px] md:text-xs font-semibold uppercase tracking-widest opacity-80 mb-6">Vos questions</h2>
        <div class="border-t border-accent/20">
          {faqItems.map((item) => (
            <details class="group border-b border-accent/20">
              <summary class="flex items-baseline justify-between gap-6 py-5 cursor-pointer list-none">
                <span>{item.q}</span>
                <span class="font-sans text-base opacity-60 group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
              </summary>
              <p class="pb-6 opacity-85">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

    </div>

    {/* Closing call to action */}
    <section class="px-6 md:px-12 mt-28 md:mt-40 pt-24 md:pt-32 pb-8 border-t border-accent/10 text-center">
      <h2 class="font-serif font-light text-[11vw] md:text-[5vw] leading-[1.05] text-balance">Votre date est-elle libre ?</h2>
      <p class="font-serif font-light text-lg md:text-xl opacity-85 mt-6 text-balance">
        Écrivez-moi, je vous réponds personnellement. Vous pouvez aussi m'appeler au <a href="tel:+33652253578" class="border-b border-accent/40">06 52 25 35 78</a>.
      </p>
      <a href="/contact/" class="inline-block mt-10 font-sans text-xs uppercase tracking-[0.2em] border-b border-accent/60 pb-1 hover:opacity-70 transition-opacity">Vérifier ma date</a>
    </section>

  </article>

</Layout>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
