---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// [OPTIM] LISTE DES ARTICLES « CONSEILS ».
// Page volontairement discrète : elle n'est pas dans le menu (demande de Hedi,
// les visiteurs doivent d'abord arriver sur l'accueil). Elle sert surtout à
// Google, qui a besoin d'un lien vers chaque article pour le trouver. On y
// accède par le pied de page.
const entries = (await getCollection('conseils')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'));

const title = "Conseils mariage : séance d'engagement, photos de groupe, date";
const description = "Les conseils d'un photographe de mariage à Vienne et Lyon : séance d'engagement, premier regard, photos de groupe, choix de la date, des témoins et du photographe.";

const siteUrl = (Astro.site || Astro.url.origin).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "url": new URL('/conseils/', siteUrl).toString(),
  "name": title,
  "description": description,
  "inLanguage": "fr-FR",
  "about": { "@id": `${siteUrl}#business` },
  "hasPart": entries.map(entry => ({
    "@type": "BlogPosting",
    "headline": entry.data.title,
    "url": new URL(`/conseils/${entry.id}/`, siteUrl).toString()
  }))
};
---

<Layout title={title} description={description} hideLoadingOverlay={true}>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="w-full bg-surface text-accent">

    <header class="px-6 md:px-12 pt-32 md:pt-44 max-w-3xl mx-auto">
      <p class="font-sans text-[10px] md:text-xs uppercase tracking-[0.2em] opacity-80 mb-6">Photo &amp; Dragée</p>
      <h1 class="font-serif font-light text-[12vw] md:text-[5.2vw] leading-[1.02] tracking-[-0.02em] text-balance">Conseils mariage</h1>
      <p class="font-serif font-light text-xl md:text-2xl leading-snug text-balance mt-8 opacity-90">
        Quelques repères pour préparer votre journée et vos photos, par un <a href="/photographe-mariage-vienne/" class="border-b border-accent/40">photographe de mariage à Vienne</a>.
      </p>
    </header>

    <div class="px-6 md:px-12 max-w-3xl mx-auto mt-20 md:mt-28 font-serif font-light text-lg md:text-xl leading-relaxed">
      <ul class="list-none p-0 m-0 border-t border-accent/20">
        {entries.map(entry => (
          <li class="border-b border-accent/20">
            <a href={`/conseils/${entry.id}/`} class="block py-6 hover:opacity-70 transition-opacity">
              <span class="block text-2xl md:text-3xl leading-tight text-balance">{entry.data.title}</span>
              <span class="block mt-2 opacity-75 text-base md:text-lg">{entry.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <section class="px-6 md:px-12 mt-28 md:mt-40 pt-24 md:pt-32 pb-8 border-t border-accent/10 text-center">
      <h2 class="font-serif font-light text-[11vw] md:text-[5vw] leading-[1.05] text-balance">Votre date est-elle libre ?</h2>
      <a href="/contact/" class="inline-block mt-10 font-sans text-xs uppercase tracking-[0.2em] border-b border-accent/60 pb-1 hover:opacity-70 transition-opacity">Vérifier ma date</a>
    </section>

  </article>

</Layout>
