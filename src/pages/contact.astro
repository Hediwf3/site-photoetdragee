---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Photographe de mariage à Vienne (Isère)" description="Contactez Photo & Dragée, photographe de mariage à Vienne (Isère) & Lyon : vérifiez la disponibilité de votre date et parlez-nous de votre mariage." hideFooter={true} hideLoadingOverlay={true}>
  
  {/* Using Global Layout Header for Menu / Navigation consistently */}

  <section class="min-h-screen md:h-[100dvh] w-full bg-surface flex flex-col md:flex-row overflow-hidden pt-[110px] md:pt-[120px]">
    
    {/* Left Side: 40% Width, Text Only */}
    <div class="w-full md:w-[40%] min-h-[30dvh] md:h-full flex flex-col px-8 relative z-10">
      
      <div class="flex flex-col text-accent shrink-0 animate-fade-up">
        {/* Title */}
        <h1 class="text-5xl md:text-5xl lg:text-[4.5rem] xl:text-[5rem] font-serif font-light leading-[1.05] tracking-tight mb-8">
          Parlez-nous<br/><i class="lowercase text-4xl md:text-4xl lg:text-[4rem] xl:text-[4.5rem] font-serif">de votre mariage</i>
        </h1>
        
        {/* Paragraph */}
        <p class="font-sans font-light text-[13px] lg:text-sm opacity-70 max-w-[320px] mb-8 sm:mb-16 leading-relaxed">
          Nous n'acceptons qu'un nombre limité de mariages chaque année afin d'offrir une attention exclusive et entière à nos couples.
        </p>
        
        {/* Contact Links */}
        <div class="flex flex-col gap-3 font-sans font-light text-[10px] md:text-xs tracking-[0.15em] uppercase opacity-80 mt-4 md:mt-16">
          <p>Disponible en Auvergne Rhône-Alpes</p>
          <a href="https://www.instagram.com/photoetdragee/" target="_blank" class="hover:italic transition-all w-fit mt-1">Instagram @photoetdragee</a>
          <a href="mailto:photoetdragee@gmail.com" class="hover:italic transition-all w-fit py-3 border-b border-accent/30 hover:border-accent">photoetdragee@gmail.com</a>
          <a href="tel:+33652253578" class="hover:italic transition-all w-fit py-3">06 52 25 35 78</a>
        </div>
      </div>
    </div>

    {/* Right Side: 60% Width, Form Only */}
    <div class="w-full md:w-[60%] min-h-[60dvh] md:h-full flex flex-col pb-8 pt-8 md:pt-0 px-8 bg-surface animate-fade-in z-20 overflow-y-auto md:overflow-visible">
      <form action="https://formsubmit.co/photoetdragee@gmail.com" method="POST" class="flex flex-col h-full font-sans relative">
        
        {/* Anti-spam & Config options for FormSubmit */}
        <input type="hidden" name="_subject" value="Nouvelle demande de contact - Photo & Dragée" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={new URL('/merci/', Astro.site).toString()} />
        <input type="hidden" name="_autoresponse" value="Merci pour votre message à Photo & Dragée. Votre demande a été transmise. Je reviendrai vers vous pour échanger sur votre mariage et vérifier ma disponibilité. Votre date n’est pas réservée à ce stade. À bientôt, Hedi — photoetdragee@gmail.com — 06 52 25 35 78." />
        
        {/* Row 1 */}
        <div class="flex-1 flex flex-col justify-center items-start md:flex-row md:items-center border-b border-accent/30 group min-h-[70px] md:min-h-[40px] py-3 md:py-0">
          <label for="name" class="w-full md:w-[45%] uppercase font-serif text-[11px] md:text-sm lg:text-base tracking-[0.15em] text-accent mb-1 md:mb-0">Vos Noms : <span class="text-[9px] opacity-40 font-sans tracking-wider align-top ml-1">(REQUIS)</span></label>
          <input type="text" id="name" name="name" autocomplete="name" required class="w-full md:w-[55%] bg-transparent border-none outline-none font-serif text-left md:text-right text-base md:text-lg lg:text-xl text-accent placeholder-accent/30 focus:placeholder-transparent transition-all" placeholder="Vos prénoms" />
        </div>
        
        {/* Row 2 */}
        <div class="flex-1 flex flex-col justify-center items-start md:flex-row md:items-center border-b border-accent/30 group min-h-[70px] md:min-h-[40px] py-3 md:py-0">
          <label for="email" class="w-full md:w-[45%] uppercase font-serif text-[11px] md:text-sm lg:text-base tracking-[0.15em] text-accent mb-1 md:mb-0">Email : <span class="text-[9px] opacity-40 font-sans tracking-wider align-top ml-1">(REQUIS)</span></label>
          <input type="email" id="email" name="email" autocomplete="email" required class="w-full md:w-[55%] bg-transparent border-none outline-none font-serif text-left md:text-right text-base md:text-lg lg:text-xl text-accent placeholder-accent/30 focus:placeholder-transparent transition-all" placeholder="hello@exemple.com" />
        </div>
        
        {/* Row 3 */}
        <div class="flex-1 flex flex-col justify-center items-start md:flex-row md:items-center border-b border-accent/30 group min-h-[70px] md:min-h-[40px] py-3 md:py-0">
          <label for="date" class="w-full md:w-[45%] uppercase font-serif text-[11px] md:text-sm lg:text-base tracking-[0.15em] text-accent mb-1 md:mb-0">Date prévue : <span class="text-[9px] opacity-40 font-sans tracking-wider align-top ml-1">(REQUIS)</span></label>
          <input type="text" id="date" name="date" required minlength="10" maxlength="10" inputmode="numeric" pattern={"\\d{2}/\\d{2}/\\d{4}"} title="Format requis : JJ/MM/AAAA" class="w-full md:w-[55%] bg-transparent border-none outline-none font-serif text-left md:text-right text-sm md:text-lg lg:text-xl text-accent placeholder-accent/30 focus:placeholder-transparent transition-all" placeholder="JJ/MM/AAAA" />
        </div>

        {/* Row 4 */}
        <div class="flex-1 flex flex-col justify-center items-start md:flex-row md:items-center border-b border-accent/30 group min-h-[70px] md:min-h-[40px] py-3 md:py-0">
          <label for="location" class="w-full md:w-[45%] uppercase font-serif text-[11px] md:text-sm lg:text-base tracking-[0.15em] text-accent mb-1 md:mb-0 flex-shrink-0">Lieu du Mariage :</label>
          <input type="text" id="location" name="location" class="w-full md:w-[55%] bg-transparent border-none outline-none font-serif text-left md:text-right text-sm md:text-lg lg:text-xl text-accent placeholder-accent/30 focus:placeholder-transparent transition-all" placeholder="Château, Pays" />
        </div>

        {/* Row 5: where the couple found us, to know which channels bring requests */}
        <div class="flex-1 flex flex-col justify-center items-start md:flex-row md:items-center border-b border-accent/30 group min-h-[70px] md:min-h-[40px] py-3 md:py-0">
          <label for="source" class="w-full md:w-[45%] uppercase font-serif text-[11px] md:text-sm lg:text-base tracking-[0.15em] text-accent mb-1 md:mb-0 flex-shrink-0">Vous m'avez connu via :</label>
          <select id="source" name="source" class="w-full md:w-[55%] bg-transparent border-none outline-none font-serif text-left md:text-right md:[text-align-last:right] text-sm md:text-lg lg:text-xl text-accent cursor-pointer">
            <option value="">Choisir (facultatif)</option>
            <option>Recherche Google</option>
            <option>Google Maps</option>
            <option>Mariages.net</option>
            <option>Instagram</option>
            <option>Pinterest</option>
            <option>Le lieu de réception</option>
            <option>Un autre prestataire</option>
            <option>Un proche, le bouche-à-oreille</option>
            <option>ChatGPT ou une autre IA</option>
            <option>Autre</option>
          </select>
        </div>

        {/* Row 6 (Textarea) */}
        <div class="flex-1 flex flex-col justify-center items-start md:flex-row md:items-start border-b border-accent/30 group min-h-[90px] py-3 md:pt-6 md:pb-2">
          <label for="details" class="w-full md:w-[45%] uppercase font-serif text-[11px] md:text-sm lg:text-base tracking-[0.15em] text-accent mb-1 md:mb-0 mt-1 flex-shrink-0">Votre Vision :</label>
          <textarea id="details" name="details" class="w-full md:w-[55%] h-[50px] md:h-full bg-transparent border-none outline-none font-serif text-left md:text-right text-sm md:text-lg lg:text-xl text-accent placeholder-accent/30 focus:placeholder-transparent transition-all resize-none" placeholder="Style, ambiance..."></textarea>
        </div>

        {/* Submit Button */}
        <div class="mt-6 flex justify-end shrink-0 pb-2">
           <button type="submit" class="uppercase font-sans tracking-[0.2em] text-xs border-b border-accent py-3 min-h-[44px] hover:italic transition-all duration-300">Envoyer la demande</button>
        </div>
      </form>
    </div>
  </section>

  <script>
    import { formatWeddingDate, weddingDateError } from '../utils/contact-date.mjs';
    const dateInput = document.querySelector<HTMLInputElement>('#date');
    if (dateInput) {
      const validateDate = () => dateInput.setCustomValidity(weddingDateError(dateInput.value));
      dateInput.addEventListener('input', () => {
        dateInput.value = formatWeddingDate(dateInput.value);
        validateDate();
      });
      dateInput.addEventListener('change', validateDate);
      window.addEventListener('pageshow', validateDate);
    }
  </script>
  <style>
    @media (max-width: 767px) {
      input:not([type="hidden"]), textarea, select { font-size: 16px; }
    }
    input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
    select option { color: #1a1a1a; background: #fafafa; }
    /* Until a choice is made, look like the other fields' placeholders */
    select:has(option[value=""]:checked) { opacity: 0.4; }
  </style>
</Layout>
